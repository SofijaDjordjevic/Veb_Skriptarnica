    "@reduxjs/toolkit": "^2.12.0",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "express": "^5.2.1",
    "mongoose": "^9.6.2",
    "react-redux": "^9.3.0"
  },
